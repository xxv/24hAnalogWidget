<?xml version="1.0" encoding="utf-8"?>
<!--
  24h analog watch face, Watch Face Format v1.

  The dial is a 24 hour dial with midnight at the bottom and noon at the top, so an hour-of-day h
  (0-24, fractional) is at angle h * 15 + 180 degrees (WFF angles are clockwise from 12 o'clock).

  Sun shading
  ===========
  WFF has no sunrise/sunset or location data sources, so the times come from four RANGED_VALUE
  complications published by the companion :sun app. Each one describes the "light" interval
  for one sun altitude threshold (daylight, civil, nautical, astronomical twilight):

    RANGED_VALUE_MIN   hour of day the interval starts (e.g. sunrise); may be negative
    RANGED_VALUE_MAX   hour of day the interval ends (e.g. sunset); may be > 24
    RANGED_VALUE_VALUE hour of day of solar noon (always within [MIN, MAX])

  Polar night is MIN == MAX; polar day is MAX - MIN == 24.

  Each slot shades the dark complement of its interval (MAX -> MIN + 24) as a pie wedge over the
  grey disc, using a translucent black. The wedges stack, so the sky gets darker through each
  twilight stage just like the original canvas-drawn face. The end angle is clamped to just under
  a full turn so polar night still draws (a 360 degree sweep would draw nothing).

  The pie is drawn as an Arc whose stroke thickness equals the disc radius, centered at half the
  radius, so it covers the disc from its center out to its edge.
-->
<WatchFace width="450" height="450">
    <Scene backgroundColor="#FF000000">

        <!-- Dial -->
        <PartImage x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Image resource="round_clock_face" />
        </PartImage>
        <PartImage x="0" y="0" width="450" height="450" alpha="0">
            <Variant mode="AMBIENT" target="alpha" value="255" />
            <Image resource="round_clock_face_ambient" />
        </PartImage>

        <!-- Sun shading. The slots all cover the grey disc (radius 138 at 450px). The bounding shape
             must cover the whole slot too: the runtime scales the complication's drawing into it.
             The slots overlap, so they aren't user-customizable; they always use the :sun app. -->

        <ComplicationSlot slotId="1" x="87" y="87" width="276" height="276"
            displayName="@string/slot_daylight" supportedTypes="RANGED_VALUE EMPTY"
            isCustomizable="FALSE">
            <DefaultProviderPolicy
                primaryProvider="info.staticfree.android.twentyfourhour.sun/info.staticfree.android.twentyfourhour.sun.DaylightComplicationService"
                primaryProviderType="RANGED_VALUE"
                defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
            <BoundingOval x="0" y="0" width="276" height="276" />
            <Complication type="RANGED_VALUE">
                <!-- Sunset to sunrise. -->
                <PartDraw x="0" y="0" width="276" height="276">
                    <Arc centerX="138" centerY="138" width="138" height="138"
                        startAngle="0" endAngle="0">
                        <Transform target="startAngle"
                            value="[COMPLICATION.RANGED_VALUE_MAX] * 15 + 180" />
                        <Transform target="endAngle"
                            value="clamp([COMPLICATION.RANGED_VALUE_MIN] * 15 + 540, [COMPLICATION.RANGED_VALUE_MAX] * 15 + 180, [COMPLICATION.RANGED_VALUE_MAX] * 15 + 539.9)" />
                        <Stroke color="#3C000000" thickness="138" cap="BUTT" />
                    </Arc>
                </PartDraw>
                <!-- In ambient the twilight wedges are hidden, so darken the night wedge to
                     roughly what all four stacked wedges look like. -->
                <PartDraw x="0" y="0" width="276" height="276" alpha="0">
                    <Variant mode="AMBIENT" target="alpha" value="255" />
                    <Arc centerX="138" centerY="138" width="138" height="138"
                        startAngle="0" endAngle="0">
                        <Transform target="startAngle"
                            value="[COMPLICATION.RANGED_VALUE_MAX] * 15 + 180" />
                        <Transform target="endAngle"
                            value="clamp([COMPLICATION.RANGED_VALUE_MIN] * 15 + 540, [COMPLICATION.RANGED_VALUE_MAX] * 15 + 180, [COMPLICATION.RANGED_VALUE_MAX] * 15 + 539.9)" />
                        <Stroke color="#8D000000" thickness="138" cap="BUTT" />
                    </Arc>
                </PartDraw>
                <!-- Solar noon marker; only when the sun actually rises. -->
                <Group x="0" y="0" width="276" height="276" name="solar_noon">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <PartDraw x="0" y="0" width="276" height="276">
                        <Transform target="alpha"
                            value="[COMPLICATION.RANGED_VALUE_MAX] > [COMPLICATION.RANGED_VALUE_MIN] ? 255 : 0" />
                        <Arc centerX="138" centerY="138" width="138" height="138"
                            startAngle="0" endAngle="0">
                            <Transform target="startAngle"
                                value="[COMPLICATION.RANGED_VALUE_VALUE] * 15 + 179" />
                            <Transform target="endAngle"
                                value="[COMPLICATION.RANGED_VALUE_VALUE] * 15 + 181" />
                            <Stroke color="#7FFFC90E" thickness="138" cap="BUTT" />
                        </Arc>
                    </PartDraw>
                </Group>
            </Complication>
            <!-- Nothing to draw; needed because EMPTY is the fallback type. -->
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot slotId="2" x="87" y="87" width="276" height="276"
            displayName="@string/slot_civil_twilight" supportedTypes="RANGED_VALUE EMPTY"
            isCustomizable="FALSE">
            <DefaultProviderPolicy
                primaryProvider="info.staticfree.android.twentyfourhour.sun/info.staticfree.android.twentyfourhour.sun.CivilTwilightComplicationService"
                primaryProviderType="RANGED_VALUE"
                defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
            <BoundingOval x="0" y="0" width="276" height="276" />
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="276" height="276">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Arc centerX="138" centerY="138" width="138" height="138"
                        startAngle="0" endAngle="0">
                        <Transform target="startAngle"
                            value="[COMPLICATION.RANGED_VALUE_MAX] * 15 + 180" />
                        <Transform target="endAngle"
                            value="clamp([COMPLICATION.RANGED_VALUE_MIN] * 15 + 540, [COMPLICATION.RANGED_VALUE_MAX] * 15 + 180, [COMPLICATION.RANGED_VALUE_MAX] * 15 + 539.9)" />
                        <Stroke color="#3C000000" thickness="138" cap="BUTT" />
                    </Arc>
                </PartDraw>
            </Complication>
            <!-- Nothing to draw; needed because EMPTY is the fallback type. -->
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot slotId="3" x="87" y="87" width="276" height="276"
            displayName="@string/slot_nautical_twilight" supportedTypes="RANGED_VALUE EMPTY"
            isCustomizable="FALSE">
            <DefaultProviderPolicy
                primaryProvider="info.staticfree.android.twentyfourhour.sun/info.staticfree.android.twentyfourhour.sun.NauticalTwilightComplicationService"
                primaryProviderType="RANGED_VALUE"
                defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
            <BoundingOval x="0" y="0" width="276" height="276" />
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="276" height="276">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Arc centerX="138" centerY="138" width="138" height="138"
                        startAngle="0" endAngle="0">
                        <Transform target="startAngle"
                            value="[COMPLICATION.RANGED_VALUE_MAX] * 15 + 180" />
                        <Transform target="endAngle"
                            value="clamp([COMPLICATION.RANGED_VALUE_MIN] * 15 + 540, [COMPLICATION.RANGED_VALUE_MAX] * 15 + 180, [COMPLICATION.RANGED_VALUE_MAX] * 15 + 539.9)" />
                        <Stroke color="#3C000000" thickness="138" cap="BUTT" />
                    </Arc>
                </PartDraw>
            </Complication>
            <!-- Nothing to draw; needed because EMPTY is the fallback type. -->
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot slotId="4" x="87" y="87" width="276" height="276"
            displayName="@string/slot_astronomical_twilight" supportedTypes="RANGED_VALUE EMPTY"
            isCustomizable="FALSE">
            <DefaultProviderPolicy
                primaryProvider="info.staticfree.android.twentyfourhour.sun/info.staticfree.android.twentyfourhour.sun.AstronomicalTwilightComplicationService"
                primaryProviderType="RANGED_VALUE"
                defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
            <BoundingOval x="0" y="0" width="276" height="276" />
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="276" height="276">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Arc centerX="138" centerY="138" width="138" height="138"
                        startAngle="0" endAngle="0">
                        <Transform target="startAngle"
                            value="[COMPLICATION.RANGED_VALUE_MAX] * 15 + 180" />
                        <Transform target="endAngle"
                            value="clamp([COMPLICATION.RANGED_VALUE_MIN] * 15 + 540, [COMPLICATION.RANGED_VALUE_MAX] * 15 + 180, [COMPLICATION.RANGED_VALUE_MAX] * 15 + 539.9)" />
                        <Stroke color="#3C000000" thickness="138" cap="BUTT" />
                    </Arc>
                </PartDraw>
            </Complication>
            <!-- Nothing to draw; needed because EMPTY is the fallback type. -->
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <!-- Date (behind hands) -->
        <Group x="276" y="194" width="78" height="52" name="date_group">
            <PartDraw x="0" y="0" width="78" height="52">
                <RoundRectangle x="0" y="0" width="78" height="52" cornerRadiusX="8" cornerRadiusY="8">
                    <Fill color="#D0111111" />
                </RoundRectangle>
            </PartDraw>

            <PartText x="0" y="3" width="78" height="20">
                <Text align="CENTER">
                    <Font family="SYNC_TO_DEVICE" size="13" color="#FFBBBBBB">
                        <Template>%s<Parameter expression="[MONTH_S]" /></Template>
                    </Font>
                </Text>
            </PartText>

            <PartText x="0" y="19" width="78" height="33">
                <Text align="CENTER">
                    <Font family="SYNC_TO_DEVICE" size="24" color="#FFFFFFFF" weight="BOLD">
                        <Template>%d<Parameter expression="[DAY]" /></Template>
                    </Font>
                </Text>
            </PartText>
        </Group>

        <!-- Hands. The hour hand makes one turn per 24 hours with midnight at the bottom. -->
        <Group x="0" y="0" width="450" height="450" name="hour_hand_group">
            <Transform target="angle" value="(([HOUR_0_23] + 12) % 24) * 15 + ([MINUTE] * 0.25)" />
            <PartImage x="0" y="0" width="450" height="450">
                <Variant mode="AMBIENT" target="alpha" value="0" />
                <Image resource="wear_hour_hand" />
            </PartImage>
            <PartImage x="0" y="0" width="450" height="450" alpha="0">
                <Variant mode="AMBIENT" target="alpha" value="255" />
                <Image resource="wear_hour_hand_ambient" />
            </PartImage>
        </Group>

        <Group x="0" y="0" width="450" height="450" name="minute_hand_group">
            <Transform target="angle" value="[MINUTE] * 6" />
            <PartImage x="0" y="0" width="450" height="450">
                <Variant mode="AMBIENT" target="alpha" value="0" />
                <Image resource="wear_minute_hand" />
            </PartImage>
            <PartImage x="0" y="0" width="450" height="450" alpha="0">
                <Variant mode="AMBIENT" target="alpha" value="255" />
                <Image resource="wear_minute_hand_ambient" />
            </PartImage>
        </Group>

    </Scene>
</WatchFace>
